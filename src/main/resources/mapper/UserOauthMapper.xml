        <result column="updated_at" property="updatedAt" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, user_id, provider, provider_account_id, email, nickname, avatar, access_token, refresh_token, expired_at, created_at, updated_at
    </sql>

</mapper>
